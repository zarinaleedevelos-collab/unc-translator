<mxfile host="app.diagrams.net" type="device"><diagram id="page1" name="A - Algorithms used"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1300" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Diagram A — Which algorithm is used where" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="700" height="40" as="geometry"/></mxCell><mxCell id="IN" value="&lt;b&gt;Bikol-Naga input&lt;/b&gt;&lt;br&gt;(typed or mic)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fontSize=12;fontStyle=1;fillColor=#f1f3f5;strokeColor=#495057;" vertex="1" parent="1"><mxGeometry x="160" y="70" width="320" height="50" as="geometry"/></mxCell><mxCell id="PRE" value="Normalize + split into sentences&lt;br&gt;&lt;i&gt;text normalization&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;fillColor=#e7f5ff;strokeColor=#1c7ed6;" vertex="1" parent="1"><mxGeometry x="160" y="150" width="320" height="50" as="geometry"/></mxCell><mxCell id="S1" value="&lt;b&gt;1. Exact match&lt;/b&gt;&lt;br&gt;&lt;i&gt;hash table lookup&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;fillColor=#e7f5ff;strokeColor=#1c7ed6;" vertex="1" parent="1"><mxGeometry x="160" y="230" width="320" height="55" as="geometry"/></mxCell><mxCell id="S2" value="&lt;b&gt;2. Single word&lt;/b&gt;&lt;br&gt;&lt;i&gt;dictionary lookup&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;fillColor=#e7f5ff;strokeColor=#1c7ed6;" vertex="1" parent="1"><mxGeometry x="160" y="320" width="320" height="55" as="geometry"/></mxCell><mxCell id="S3" value="&lt;b&gt;3. Adapt a similar sentence&lt;/b&gt;&lt;br&gt;&lt;i&gt;TF-IDF character n-gram retrieval&lt;/i&gt;&lt;br&gt;&lt;i&gt;+ sequence alignment, max 2 word swaps&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;fillColor=#e7f5ff;strokeColor=#1c7ed6;" vertex="1" parent="1"><mxGeometry x="160" y="410" width="320" height="75" as="geometry"/></mxCell><mxCell id="S4" value="&lt;b&gt;4. Grammar rules&lt;/b&gt;&lt;br&gt;&lt;i&gt;rule-based parsing&lt;/i&gt;&lt;br&gt;&lt;i&gt;Mintz 1971, Epstein 1967&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;fillColor=#e7f5ff;strokeColor=#1c7ed6;" vertex="1" parent="1"><mxGeometry x="160" y="520" width="320" height="70" as="geometry"/></mxCell><mxCell id="S5" value="&lt;b&gt;5. AI MODEL (NEW)&lt;/b&gt;&lt;br&gt;&lt;i&gt;fine-tuned Transformer NMT&lt;/i&gt;&lt;br&gt;&lt;i&gt;+ beam search&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;fillColor=#ffe8cc;strokeColor=#d9480f;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="160" y="625" width="320" height="70" as="geometry"/></mxCell><mxCell id="GR" value="&lt;b&gt;Guardrails&lt;/b&gt;&lt;br&gt;&lt;i&gt;confidence score&lt;/i&gt;&lt;br&gt;&lt;i&gt;+ IBM Model 1 alignment check&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;fillColor=#ffe8cc;strokeColor=#d9480f;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="160" y="730" width="320" height="70" as="geometry"/></mxCell><mxCell id="S6" value="&lt;b&gt;6. Word-by-word&lt;/b&gt;&lt;br&gt;&lt;i&gt;greedy longest-phrase match&lt;/i&gt;&lt;br&gt;&lt;i&gt;+ fuzzy spelling hints&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;fillColor=#e7f5ff;strokeColor=#1c7ed6;" vertex="1" parent="1"><mxGeometry x="160" y="835" width="320" height="70" as="geometry"/></mxCell><mxCell id="OUT" value="&lt;b&gt;English result + label&lt;/b&gt;&lt;br&gt;exact / adapted / grammar /&lt;br&gt;AI-translated / rough / partial" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fontSize=12;fontStyle=1;fillColor=#d3f9d8;strokeColor=#2f9e44;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="160" y="945" width="320" height="70" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="IN" target="PRE"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="PRE" target="S1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="S1" target="S2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="S2" target="S3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e5" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="S3" target="S4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e6" value="cannot parse" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="S4" target="S5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="S5" target="GR"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e8" value="rejected" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="GR" target="S6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="S6" target="OUT"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e10" value="found" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="S1" target="OUT"><mxGeometry relative="1" x="-0.75" as="geometry"></mxGeometry></mxCell><mxCell id="e11" value="found" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="S2" target="OUT"><mxGeometry relative="1" x="-0.75" as="geometry"></mxGeometry></mxCell><mxCell id="e12" value="adapted" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="S3" target="OUT"><mxGeometry relative="1" x="-0.75" as="geometry"></mxGeometry></mxCell><mxCell id="e13" value="built" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="S4" target="OUT"><mxGeometry relative="1" x="-0.75" as="geometry"></mxGeometry></mxCell><mxCell id="e14" value="passed" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="GR" target="OUT"><mxGeometry relative="1" x="-0.75" as="geometry"></mxGeometry></mxCell><mxCell id="leg1" value="Existing step" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;fillColor=#e7f5ff;strokeColor=#1c7ed6;" vertex="1" parent="1"><mxGeometry x="620" y="70" width="130" height="30" as="geometry"/></mxCell><mxCell id="leg2" value="New AI step" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;fillColor=#ffe8cc;strokeColor=#d9480f;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="620" y="110" width="130" height="30" as="geometry"/></mxCell><mxCell id="leg3" value="Final output" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fontSize=12;fontStyle=1;fillColor=#d3f9d8;strokeColor=#2f9e44;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="620" y="150" width="130" height="30" as="geometry"/></mxCell><mxCell id="note" value="Steps 1–4 and 6 already exist in engine.py / grammar.py.&lt;br&gt;Step 5 + guardrails are the new AI model." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;fontSize=11;fillColor=#fff9db;strokeColor=#f08c00;" vertex="1" parent="1"><mxGeometry x="620" y="200" width="230" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="page2" name="B - AI model (Transformer)"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1300" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Diagram B — The AI model inside step 5 (Transformer encoder–decoder, MarianMT)" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="900" height="40" as="geometry"/></mxCell><mxCell id="B" value="&lt;b&gt;Bikol sentence&lt;/b&gt;&lt;br&gt;'Nagkakakan ako nin kanon'" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fontSize=12;fontStyle=1;fillColor=#f1f3f5;strokeColor=#495057;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="280" height="55" as="geometry"/></mxCell><mxCell id="TOK" value="&lt;b&gt;SentencePiece tokenizer&lt;/b&gt;&lt;br&gt;splits words into pieces&lt;br&gt;nag + ka + kakan ..." style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;fillColor=#e7f5ff;strokeColor=#1c7ed6;" vertex="1" parent="1"><mxGeometry x="40" y="160" width="280" height="65" as="geometry"/></mxCell><mxCell id="EMB" value="&lt;b&gt;Embeddings + positions&lt;/b&gt;&lt;br&gt;each piece becomes 512 numbers" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;fillColor=#e7f5ff;strokeColor=#1c7ed6;" vertex="1" parent="1"><mxGeometry x="40" y="260" width="280" height="55" as="geometry"/></mxCell><mxCell id="ENC" value="ENCODER — reads the Bikol sentence (× 6 layers)" style="swimlane;whiteSpace=wrap;html=1;rounded=1;startSize=30;fontStyle=1;fontSize=12;fillColor=#e7f5ff;strokeColor=#1c7ed6;" vertex="1" parent="1"><mxGeometry x="20" y="350" width="320" height="250" as="geometry"/></mxCell><mxCell id="E1" value="&lt;b&gt;Self-attention&lt;/b&gt;&lt;br&gt;each word looks at every other&lt;br&gt;Bikol word for context" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;fillColor=#ffffff;strokeColor=#1c7ed6;" vertex="1" parent="ENC"><mxGeometry x="20" y="45" width="280" height="75" as="geometry"/></mxCell><mxCell id="E2" value="&lt;b&gt;Feed-forward network&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;fillColor=#ffffff;strokeColor=#1c7ed6;" vertex="1" parent="ENC"><mxGeometry x="20" y="160" width="280" height="50" as="geometry"/></mxCell><mxCell id="DEC" value="DECODER — writes English one piece at a time (× 6 layers)" style="swimlane;whiteSpace=wrap;html=1;rounded=1;startSize=30;fontStyle=1;fontSize=12;fillColor=#fff4e6;strokeColor=#e8590c;" vertex="1" parent="1"><mxGeometry x="480" y="350" width="340" height="360" as="geometry"/></mxCell><mxCell id="D1" value="&lt;b&gt;Masked self-attention&lt;/b&gt;&lt;br&gt;looks at the English written so far" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;fillColor=#ffffff;strokeColor=#e8590c;" vertex="1" parent="DEC"><mxGeometry x="30" y="45" width="280" height="65" as="geometry"/></mxCell><mxCell id="D2" value="&lt;b&gt;Cross-attention&lt;/b&gt;&lt;br&gt;looks back at the Bikol words&lt;br&gt;to decide what comes next" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;fillColor=#ffffff;strokeColor=#e8590c;" vertex="1" parent="DEC"><mxGeometry x="30" y="145" width="280" height="75" as="geometry"/></mxCell><mxCell id="D3" value="&lt;b&gt;Feed-forward network&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;fillColor=#ffffff;strokeColor=#e8590c;" vertex="1" parent="DEC"><mxGeometry x="30" y="260" width="280" height="50" as="geometry"/></mxCell><mxCell id="SM" value="&lt;b&gt;Softmax&lt;/b&gt;&lt;br&gt;probability of every possible next piece&lt;br&gt;(58,455-piece vocabulary)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;fillColor=#fff4e6;strokeColor=#e8590c;" vertex="1" parent="1"><mxGeometry x="510" y="750" width="280" height="65" as="geometry"/></mxCell><mxCell id="BEAM" value="&lt;b&gt;Beam search (beam = 4)&lt;/b&gt;&lt;br&gt;keeps the 4 best partial sentences" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;fillColor=#fff4e6;strokeColor=#e8590c;" vertex="1" parent="1"><mxGeometry x="510" y="850" width="280" height="60" as="geometry"/></mxCell><mxCell id="EN" value="&lt;b&gt;English sentence&lt;/b&gt;&lt;br&gt;'I am eating rice.'" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;fillColor=#d3f9d8;strokeColor=#2f9e44;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="340" y="960" width="230" height="55" as="geometry"/></mxCell><mxCell id="CONF" value="&lt;b&gt;Confidence score&lt;/b&gt;&lt;br&gt;average log-probability" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;fillColor=#ffe8cc;strokeColor=#d9480f;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="640" y="960" width="230" height="55" as="geometry"/></mxCell><mxCell id="GUARD" value="&lt;b&gt;Guardrails pass?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffe8cc;strokeColor=#d9480f;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="520" y="1060" width="180" height="90" as="geometry"/></mxCell><mxCell id="SHOW" value="Show as &lt;b&gt;AI-translated&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fontSize=12;fontStyle=1;fillColor=#d3f9d8;strokeColor=#2f9e44;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="340" y="1200" width="220" height="50" as="geometry"/></mxCell><mxCell id="FALL" value="Fall back to &lt;b&gt;word-by-word&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fontSize=12;fontStyle=1;fillColor=#f1f3f5;strokeColor=#495057;" vertex="1" parent="1"><mxGeometry x="660" y="1200" width="220" height="50" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="B" target="TOK"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="TOK" target="EMB"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="EMB" target="ENC"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="E1" target="E2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="D1" target="D2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="D2" target="D3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e7" value="meaning of each Bikol&lt;br&gt;word in context" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ENC" target="D2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="DEC" target="SM"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="SM" target="BEAM"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e10" value="next piece&lt;br&gt;fed back" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="BEAM" target="D1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="900" y="880"/><mxPoint x="900" y="427"/></Array></mxGeometry></mxCell><mxCell id="e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="BEAM" target="EN"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="BEAM" target="CONF"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="EN" target="GUARD"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="CONF" target="GUARD"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e15" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="GUARD" target="SHOW"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e16" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="GUARD" target="FALL"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="note" value="&lt;b&gt;Model size&lt;/b&gt; (from config.json of&lt;br&gt;Helsinki-NLP/opus-mt-bcl-en)&lt;br&gt;• 6 encoder + 6 decoder layers&lt;br&gt;• 512-number vectors&lt;br&gt;• 8 attention heads&lt;br&gt;• 58,455-piece vocabulary&lt;br&gt;• about 300 MB" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;fontSize=11;fillColor=#fff9db;strokeColor=#f08c00;" vertex="1" parent="1"><mxGeometry x="960" y="70" width="250" height="150" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="page3" name="C - Training pipeline"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1300" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Diagram C — How the AI model is made (training pipeline)" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="900" height="40" as="geometry"/></mxCell><mxCell id="DATA" value="1. Our dataset" style="swimlane;whiteSpace=wrap;html=1;rounded=1;startSize=30;fontStyle=1;fontSize=12;fillColor=#f1f3f5;strokeColor=#495057;" vertex="1" parent="1"><mxGeometry x="20" y="170" width="200" height="270" as="geometry"/></mxCell><mxCell id="C1" value="&lt;b&gt;corpus.csv&lt;/b&gt;&lt;br&gt;3,184 pairs" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;fillColor=#ffffff;strokeColor=#495057;" vertex="1" parent="DATA"><mxGeometry x="20" y="45" width="160" height="55" as="geometry"/></mxCell><mxCell id="C2" value="&lt;b&gt;sentences.csv&lt;/b&gt;&lt;br&gt;619 pairs" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;fillColor=#ffffff;strokeColor=#495057;" vertex="1" parent="DATA"><mxGeometry x="20" y="115" width="160" height="55" as="geometry"/></mxCell><mxCell id="C3" value="&lt;b&gt;dictionary.csv&lt;/b&gt;&lt;br&gt;2,528 words" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;fillColor=#ffffff;strokeColor=#495057;" vertex="1" parent="DATA"><mxGeometry x="20" y="185" width="160" height="55" as="geometry"/></mxCell><mxCell id="CLEAN" value="&lt;b&gt;2. Clean&lt;/b&gt;&lt;br&gt;fix review list,&lt;br&gt;resolve conflicts,&lt;br&gt;remove duplicates" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;fillColor=#e7f5ff;strokeColor=#1c7ed6;" vertex="1" parent="1"><mxGeometry x="270" y="255" width="160" height="100" as="geometry"/></mxCell><mxCell id="SPLIT" value="&lt;b&gt;3. Split by group&lt;/b&gt;&lt;br&gt;80% train&lt;br&gt;10% validation&lt;br&gt;10% test" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;fillColor=#e7f5ff;strokeColor=#1c7ed6;" vertex="1" parent="1"><mxGeometry x="480" y="255" width="160" height="100" as="geometry"/></mxCell><mxCell id="PRE" value="&lt;b&gt;Pretrained model&lt;/b&gt;&lt;br&gt;Helsinki-NLP opus-mt-bcl-en&lt;br&gt;(knows formal Bikol)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;fillColor=#f1f3f5;strokeColor=#495057;" vertex="1" parent="1"><mxGeometry x="945" y="50" width="220" height="70" as="geometry"/></mxCell><mxCell id="COLAB" value="Google Colab — free GPU" style="swimlane;whiteSpace=wrap;html=1;rounded=1;startSize=30;fontStyle=1;fontSize=12;fillColor=#fff4e6;strokeColor=#e8590c;" vertex="1" parent="1"><mxGeometry x="700" y="160" width="640" height="380" as="geometry"/></mxCell><mxCell id="S0" value="&lt;b&gt;4. Step 0 check&lt;/b&gt;&lt;br&gt;50 sentences rated&lt;br&gt;by a Bikol speaker" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;fillColor=#ffffff;strokeColor=#e8590c;" vertex="1" parent="COLAB"><mxGeometry x="20" y="60" width="160" height="80" as="geometry"/></mxCell><mxCell id="FT" value="&lt;b&gt;5. Fine-tune&lt;/b&gt;&lt;br&gt;cross-entropy + AdamW&lt;br&gt;label smoothing 0.1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;fillColor=#ffe8cc;strokeColor=#d9480f;strokeWidth=2;" vertex="1" parent="COLAB"><mxGeometry x="220" y="60" width="180" height="80" as="geometry"/></mxCell><mxCell id="VAL" value="&lt;b&gt;6. Validation chrF&lt;br&gt;still improving?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#e8590c;" vertex="1" parent="COLAB"><mxGeometry x="220" y="200" width="180" height="120" as="geometry"/></mxCell><mxCell id="TEST" value="&lt;b&gt;7. Test set&lt;/b&gt;&lt;br&gt;used once&lt;br&gt;chrF, BLEU, F1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;fillColor=#ffffff;strokeColor=#e8590c;" vertex="1" parent="COLAB"><mxGeometry x="470" y="220" width="140" height="80" as="geometry"/></mxCell><mxCell id="MODEL" value="&lt;b&gt;8. OUR MODEL&lt;/b&gt;&lt;br&gt;unc-bcl-en&lt;br&gt;about 300 MB" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;fillColor=#d3f9d8;strokeColor=#2f9e44;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1400" y="375" width="170" height="80" as="geometry"/></mxCell><mxCell id="SERVER" value="&lt;b&gt;9. Flask server&lt;/b&gt;&lt;br&gt;runs on CPU, offline" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fontSize=12;fontStyle=1;fillColor=#e7f5ff;strokeColor=#1c7ed6;" vertex="1" parent="1"><mxGeometry x="1400" y="510" width="170" height="60" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="DATA" target="CLEAN"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="CLEAN" target="SPLIT"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="50 sentences" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="SPLIT" target="S0"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" value="train + validation" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="SPLIT" target="FT"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="560" y="140"/><mxPoint x="965" y="140"/></Array></mxGeometry></mxCell><mxCell id="e5" value="starting weights" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;entryX=0.75;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="PRE" target="FT"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e6" value="go" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="S0" target="FT"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="FT" target="VAL"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e8" value="yes: next epoch" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="VAL" target="FT"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="895" y="420"/><mxPoint x="895" y="280"/></Array></mxGeometry></mxCell><mxCell id="e9" value="no: early stop" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="VAL" target="TEST"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="TEST" target="MODEL"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="MODEL" target="SERVER"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="page4" name="D - IBM Model 1 (EM)"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1300" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Diagram D — IBM Model 1, the algorithm we build from scratch (Expectation–Maximization)" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1000" height="40" as="geometry"/></mxCell><mxCell id="P" value="&lt;b&gt;Our sentence pairs&lt;/b&gt;&lt;br&gt;'Mainom ako nin tubig' = 'I will drink water'" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fontSize=12;fontStyle=1;fillColor=#f1f3f5;strokeColor=#495057;" vertex="1" parent="1"><mxGeometry x="260" y="70" width="340" height="55" as="geometry"/></mxCell><mxCell id="INIT" value="&lt;b&gt;Start&lt;/b&gt;&lt;br&gt;every Bikol word is equally likely&lt;br&gt;to mean every English word" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;fillColor=#e7f5ff;strokeColor=#1c7ed6;" vertex="1" parent="1"><mxGeometry x="260" y="160" width="340" height="65" as="geometry"/></mxCell><mxCell id="E" value="&lt;b&gt;E-step&lt;/b&gt;&lt;br&gt;in each pair, estimate how likely each&lt;br&gt;Bikol word lines up with each English word" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;fillColor=#e7f5ff;strokeColor=#1c7ed6;" vertex="1" parent="1"><mxGeometry x="260" y="260" width="340" height="70" as="geometry"/></mxCell><mxCell id="M" value="&lt;b&gt;M-step&lt;/b&gt;&lt;br&gt;add up those estimates over all pairs&lt;br&gt;and update the word-translation table" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;fillColor=#e7f5ff;strokeColor=#1c7ed6;" vertex="1" parent="1"><mxGeometry x="260" y="365" width="340" height="70" as="geometry"/></mxCell><mxCell id="CHK" value="&lt;b&gt;Table still changing?&lt;/b&gt;&lt;br&gt;(about 10 rounds)" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;fillColor=#e7f5ff;strokeColor=#1c7ed6;" vertex="1" parent="1"><mxGeometry x="330" y="470" width="200" height="110" as="geometry"/></mxCell><mxCell id="T" value="&lt;b&gt;Learned table&lt;/b&gt; (example values)&lt;br&gt;tubig → water 0.9&lt;br&gt;inom → drink 0.8 ..." style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;fillColor=#d3f9d8;strokeColor=#2f9e44;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="260" y="620" width="340" height="70" as="geometry"/></mxCell><mxCell id="U1" value="&lt;b&gt;Baseline translator&lt;/b&gt;&lt;br&gt;for Chapter 4 comparison" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;fillColor=#f1f3f5;strokeColor=#495057;" vertex="1" parent="1"><mxGeometry x="20" y="740" width="240" height="65" as="geometry"/></mxCell><mxCell id="U2" value="&lt;b&gt;Guardrail&lt;/b&gt;&lt;br&gt;checks that AI output covers&lt;br&gt;the Bikol content words" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;fillColor=#ffe8cc;strokeColor=#d9480f;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="310" y="740" width="240" height="65" as="geometry"/></mxCell><mxCell id="U3" value="&lt;b&gt;Suggested glosses&lt;/b&gt; for words&lt;br&gt;missing from the dictionary&lt;br&gt;(for researchers to review)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;fillColor=#fff9db;strokeColor=#f08c00;" vertex="1" parent="1"><mxGeometry x="600" y="740" width="240" height="65" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="P" target="INIT"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="INIT" target="E"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="E" target="M"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="M" target="CHK"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e5" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="CHK" target="E"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="680" y="525"/><mxPoint x="680" y="295"/></Array></mxGeometry></mxCell><mxCell id="e6" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="CHK" target="T"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="T" target="U1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="T" target="U2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="T" target="U3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>